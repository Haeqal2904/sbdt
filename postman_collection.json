{
  "info": {
    "name": "Kapita - Distributed DB, SSO & ML API",
    "_postman_id": "c6130fa9-9bf5-4b21-827b-e1c8d1e39b70",
    "description": "Postman Collection for Kapita Integrated Project (Distributed PostgreSQL, Keycloak SSO, FastAPI ML Inference)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "2. Database Replication Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/db/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "db", "status"]
        }
      }
    },
    {
      "name": "3. Obtain SSO Token (Keycloak Password Grant)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
              "    console.log('Saved accessToken to collection variable');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student\",\n  \"password\": \"student123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "token"]
        }
      }
    },
    {
      "name": "4. Get Current User Profile (SSO)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      }
    },
    {
      "name": "5. ML Predict & Write to Primary DB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": 5.1,\n  \"sepal_width\": 3.5,\n  \"petal_length\": 1.4,\n  \"petal_width\": 0.2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/predict",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "predict"]
        }
      }
    },
    {
      "name": "6. Query History from Read-Replica DB",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/predictions?limit=10&offset=0",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "predictions"],
          "query": [
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      }
    }
  ]
}

