# ==============================================================
# Environment Configuration for Kapita Integrated Project
# ==============================================================

# Database Settings
DB_PRIMARY_HOST=postgres-primary
DB_PRIMARY_PORT=5432
DB_PRIMARY_USER=app_user
DB_PRIMARY_PASSWORD=app_password
DB_PRIMARY_NAME=app_db

DB_REPLICA_HOST=postgres-replica
DB_REPLICA_PORT=5432
DB_REPLICA_USER=app_user
DB_REPLICA_PASSWORD=app_password
DB_REPLICA_NAME=app_db

# Keycloak SSO Settings
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=kapita-realm
KEYCLOAK_CLIENT_ID=api-client
KEYCLOAK_CLIENT_SECRET=api-client-secret-12345

# ML Model
MODEL_PATH=model/model.joblib

